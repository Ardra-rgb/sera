<% content_for :title, "Chat #{@chat.id}" %>

<%= turbo_stream_from "chat_#{@chat.id}" %>

<div class="chat-page">
  <header class="chat-header">
    <div>
      <h1>Chat <%= @chat.id %></h1>
      <p>
        Using
        <strong><%= @chat.model&.label || default_model_display_name %></strong>
      </p>
    </div>
  </header>

  <% if notice.present? %>
    <div class="chat-notice">
      <%= notice %>
    </div>
  <% end %>

  <section class="chat-content">
    <%= render "application_status" %>

    <div id="messages" class="messages-container">
      <% @chat.messages.where.not(id: nil).each do |message| %>
        <%= render message %>
      <% end %>
    </div>
  </section>

  <div class="chat-composer">
    <%= render "messages/form", chat: @chat, message: @message %>
  </div>
</div>